{
  "name": "labs-snippet-regex-library",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Monorepo snippet & regex library: Fastify API, React + Vite web, Drizzle ORM di atas PostgreSQL (pgvector).",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:api": "turbo run dev --filter=@snippets/api",
    "dev:web": "turbo run dev --filter=@snippets/web",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint -- --write",
    "typecheck": "turbo run typecheck",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "format": "biome format --write .",
    "test:api": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/api-smoke-test.ps1",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:generate": "turbo run db:generate",
    "db:migrate": "turbo run db:migrate",
    "db:push": "turbo run db:push",
    "db:enable-vector": "docker compose exec postgres psql -U dev -d snippets_db -c \"CREATE EXTENSION IF NOT EXISTS vector;\"",
    "db:studio": "turbo run db:studio"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  }
}
