{
  "name": "@snippets/db",
  "version": "0.0.0",
  "private": true,
  "description": "Skema Drizzle ORM + koneksi PostgreSQL (pgvector-ready) untuk snippets_db.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx src/seed.ts",
    "db:studio": "drizzle-kit studio",
    "lint": "biome check --config-path=../../biome.json .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@snippets/shared": "workspace:*",
    "drizzle-orm": "catalog:",
    "postgres": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@snippets/config": "workspace:*",
    "@types/node": "catalog:",
    "drizzle-kit": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
