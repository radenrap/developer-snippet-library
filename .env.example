# ---------------------------------------------------------------------------
# Salin file ini menjadi `.env` lalu sesuaikan value-nya.
# Jangan pernah commit file `.env` ke repository.
#
# Siapa yang membaca file ini:
#   - docker compose : otomatis membaca .env di root project
#   - turbo          : meneruskan variabel shell yang terdaftar di turbo.json
#                      (globalEnv) ke task dev/build/lint/typecheck
#   - apps/api       : TIDAK memuat .env otomatis; semua variabel di bawah
#                      punya default yang sama persis dengan docker-compose.yml,
#                      jadi `pnpm dev` langsung jalan tanpa .env
#   - apps/web       : Vite memuat apps/web/.env (prefix VITE_ wajib untuk
#                      variabel yang dibaca browser)
# ---------------------------------------------------------------------------

# PostgreSQL (dipakai oleh docker-compose.yml)
POSTGRES_USER=db_user
POSTGRES_PASSWORD=db_password
POSTGRES_DB=db_name
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_SSL=false

# Opsional. Bila kosong, @snippets/db merakit URL dari POSTGRES_* di atas.
DATABASE_URL=postgresql://dev:dev@localhost:5432/snippets_db

# API (apps/api) - default: 0.0.0.0:3000
API_HOST=0.0.0.0
API_PORT=3000
LOG_LEVEL=info
# Boleh beberapa origin dipisahkan koma.
CORS_ORIGIN=http://localhost:5173

# Web (apps/web) - taruh di apps/web/.env agar dibaca Vite
# /api di-proxy vite.config.ts ke http://localhost:3000 saat dev.
VITE_API_URL=/api
VITE_API_PROXY_TARGET=http://localhost:3000
